{
  "name": "nhforum-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Verifiable append-only log for nhforum v2. Pure ESM, runs unchanged in Workers, browsers and Node.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "vectors": "node scripts/gen-vectors.mjs",
    "demo": "node scripts/demo.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:realtime": "node scripts/smoke-realtime.mjs",
    "build": "node scripts/build-assets.mjs",
    "d1:init": "wrangler d1 execute nhforum --remote --file worker/schema.sql",
    "deploy": "node scripts/build-assets.mjs && wrangler deploy -c wrangler.jsonc",
    "deploy:realtime": "node scripts/build-assets.mjs && wrangler deploy -c wrangler.realtime.jsonc",
    "dev": "node scripts/build-assets.mjs && wrangler dev -c wrangler.jsonc",
    "dev:realtime": "node scripts/build-assets.mjs && wrangler dev -c wrangler.realtime.jsonc"
  },
  "devDependencies": {
    "vitest": "^3.2.4",
    "wrangler": "^4.160.0"
  }
}
